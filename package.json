{
  "name": "blog-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express and Prisma API for a MySQL-backed blog",
  "main": "http-server.js",
  "scripts": {
    "start": "node http-server.js",
    "dev": "node --watch http-server.js",
    "dev:client": "vite --config client/vite.config.js --host 127.0.0.1",
    "dev:full": "concurrently -k \"npm:dev\" \"npm:dev:client\"",
    "build:client": "vite build --config client/vite.config.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prisma": "^6.16.3",
    "vite": "^6.3.6"
  }
}
